NIVVI_DATABASE=/data/nivvi.sqlite
NIVVI_SMTP_HOST=
NIVVI_SMTP_PORT=587
NIVVI_SMTP_FROM=
NIVVI_SMTP_USER=
NIVVI_SMTP_PASSWORD=
# Optional until Apple Push Notifications is provisioned; otherwise remote sounds cannot work.
NIVVI_APNS_KEY=/run/secrets/AuthKey.p8
NIVVI_APNS_KEY_ID=
NIVVI_APNS_TEAM=
NIVVI_APNS_TOPIC=com.michael1991.nivvi
# 0 for TestFlight/App Store; 1 only for development-provisioned builds.
NIVVI_APNS_SANDBOX=0
